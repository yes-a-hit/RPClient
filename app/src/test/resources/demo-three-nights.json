  "openings": [
    {
      "speaker": "",
      "content": "值班室的灯管闪了两下才亮。四只玩偶在舞台上，但它们的姿势和你下午看到的不一样。墙上贴着半张告示：请勿在凌晨三点后离开值班室。"
    },
    {
      "speaker": "老员工留言",
      "content": "「新人听好：邦尼听声音，奇卡闻味道，霍斯要你一直看右边，弗莱迪……你最好祈祷别停电。」"
    }
  ],
  "scenes": [
    {
      "id": "night1",
      "name": "第一夜",
      "entryPrompt": "监控屏一格格亮着：舞台、左走廊、右走廊、厨房、通风管。电量从 100 开始缓慢下降。这一晚主要是邦尼在动，其他三只还没醒透。撑到六点就下班。",
      "cast": [
        {
          "name": "邦尼",
          "required": true,
          "description": "高大的兔子玩偶，站在舞台左侧。它不动的时候看不出哪里不对，但它一直在看值班室的方向。"
        },
        {
          "name": "奇卡",
          "required": true,
          "description": "系围裙的鸡形玩偶，舞台右侧。手里那盘东西从没放下过。"
